{
  "name": "zentomart-backend",
  "version": "1.0.0",
  "description": "ZentoMart REST API — Node.js + Express + MongoDB backend for the admin panel and storefront",
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed:admin": "node src/utils/seedAdmin.js",
    "seed:products": "node src/utils/seedProducts.js",
    "seed:rest": "node src/utils/seedAll.js",
    "seed": "npm run seed:admin && npm run seed:products && npm run seed:rest",
    "wipe": "node src/utils/wipeData.js",
    "wipe:yes": "node src/utils/wipeData.js --yes"
  },
  "dependencies": {
    "@imagekit/nodejs": "^7.5.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-async-handler": "^1.2.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.0",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "morgan": "^1.10.0",
    "multer": "^2.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
