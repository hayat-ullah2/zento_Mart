# Copy this file to .env and fill in your values

PORT=5000
NODE_ENV=development

# MongoDB Atlas — get this from cluster → Connect → Drivers
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/zentomart?retryWrites=true&w=majority

# Generate a strong random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
COOKIE_NAME=zentomart_token

# Admin accounts that get created by `npm run seed:admin`
SEED_ADMIN_EMAIL=admin@zentomart.com
SEED_ADMIN_PASSWORD=change_me_in_prod
SEED_ADMIN_NAME=Site Owner
SEED_MANAGER_EMAIL=manager@zentomart.com
SEED_MANAGER_PASSWORD=change_me_in_prod
SEED_MANAGER_NAME=Manager Name

CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ImageKit
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
IMAGEKIT_ID=your_imagekit_id
