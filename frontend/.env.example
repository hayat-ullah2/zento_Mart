# Copy this file to .env.local for local development.
# In production (Vercel), set these in the project's Environment Variables UI.

# URL of the deployed ZentoMart API, including the /api suffix.
# Local dev: leave unset — Vite proxies /api → http://localhost:5000 (see vite.config.js)
# Production: https://zentomart-api.onrender.com/api
VITE_API_URL=https://zentomart-api.onrender.com/api

# Cloudinary returns full https://res.cloudinary.com/... URLs in the upload
# response, so the frontend doesn't need to know the cloud name. No image-host
# env vars are required here.
